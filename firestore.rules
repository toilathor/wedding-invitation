rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin = có tài liệu admins/{uid} (tạo tay trong Firebase Console; client không ghi được).
    // Không để email nào trong repo (repo này public).
    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Quy tắc cho Sổ lưu bút (Wishes)
    match /wishes/{wishId} {
      // Cho phép mọi khách xem lời chúc
      allow read: if true;
      
      // Chỉ nhận đúng payload từ form công khai; giới hạn kích thước để giảm spam/rác dữ liệu.
      allow create: if request.resource.data.keys().hasOnly([
                      'name', 'content', 'deviceId', 'createdAt'
                    ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 160
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 3000
                    && request.resource.data.deviceId is string
                    && request.resource.data.deviceId.size() >= 8
                    && request.resource.data.deviceId.size() <= 80
                    // Bắt buộc là giờ máy chủ: không giả giờ để ghim lời chúc lên đầu hay lùi về quá khứ.
                    && request.resource.data.createdAt == request.time;
                    
      // Khóa sửa hoặc xóa đối với khách vãng lai
      // Admin ẩn/hiện lời chúc (hidden, hiddenAt) và xoá.
      allow update, delete: if isAdmin();
    }

    // Cấu hình moderation chỉ được public đọc để che từ khóa trên thiệp.
    match /settings/moderation {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Quy tắc cho Xác nhận tham dự (RSVP)
    // Document ID = số điện thoại. Chứa thông tin cá nhân nên KHÔNG cho client đọc/liệt kê:
    // chỉ chủ trang xem qua Firebase Console / Admin SDK.
    match /rsvps/{phone} {
      function validRsvp() {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'name', 'phone', 'isAttending', 'attendParty', 'attendGroom',
                 'attendBride', 'guestsCount', 'note', 'deviceId', 'createdAt'
               ])
               && d.keys().hasAll(['name', 'phone', 'isAttending', 'deviceId', 'createdAt'])
               && d.name is string && d.name.size() > 0 && d.name.size() <= 160
               && d.phone is string && d.phone == phone && phone.matches('^0[35789][0-9]{8}$')
               && d.isAttending is bool
               && (!('attendParty' in d) || d.attendParty is bool)
               && (!('attendGroom' in d) || d.attendGroom is bool)
               && (!('attendBride' in d) || d.attendBride is bool)
               && (!('guestsCount' in d) || (d.guestsCount is int && d.guestsCount >= 0 && d.guestsCount <= 20))
               && (!('note' in d) || (d.note is string && d.note.size() <= 1000))
               && d.deviceId is string && d.deviceId.size() >= 8 && d.deviceId.size() <= 80
               && d.createdAt == request.time;
      }

      // Không ai đọc được danh sách hay dò từng số điện thoại.
      // Chỉ admin đọc được (trang quản trị).
      allow get, list: if isAdmin();

      // Gửi lần đầu.
      allow create: if validRsvp();

      // Chỉ thiết bị đã gửi bản gốc mới sửa được (deviceId nằm trong tài liệu, client khác không đọc được
      // nên không thể ghi đè RSVP của người khác dù biết số điện thoại).
      allow update: if validRsvp() && resource.data.deviceId == request.resource.data.deviceId;

      allow delete: if false;
    }

    // Link ngắn ?g=MÃ: thiệp chỉ đọc được TỪNG khách theo mã (ID tài liệu = mã), không liệt kê được danh sách.
    // Lưu ý: mọi trường của khách (kể cả ghi chú) đọc được bởi ai biết mã.
    match /guests/{code} {
      allow get: if code.matches('^[A-Z]{3}[0-9]{3,6}$') || isAdmin();
      allow list, write: if isAdmin();
    }

    // Xưng hô tuỳ chỉnh: thiệp cần đọc từng cái (theo ID) để dựng lời xưng hô.
    match /honorifics/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Dữ liệu quản trị khác: chỉ admin.
    match /guestGroups/{id} { allow read, write: if isAdmin(); }
    match /settings/guestConfig { allow read, write: if isAdmin(); }

    // Quy tắc cho Theo dõi thiết bị khách truy cập (Visitors)
    match /visitors/{visitorId} {
      function validVisitorData() {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'visitorId', 'deviceType', 'os', 'browser', 'screen',
                 'language', 'referrer', 'guestCode', 'guestName',
                 'visitCount', 'firstVisit', 'lastVisit'
               ])
            && d.keys().hasAll([
                 'visitorId', 'deviceType', 'os', 'browser', 'screen',
                 'visitCount', 'firstVisit', 'lastVisit'
               ])
            && d.visitorId is string
            && d.visitorId == visitorId
            && d.visitorId.size() >= 8
            && d.visitorId.size() <= 80
            && d.deviceType is string
            && d.deviceType in ['mobile', 'tablet', 'desktop', 'other']
            && d.os is string
            && d.os.size() >= 1
            && d.os.size() <= 40
            && d.browser is string
            && d.browser.size() >= 1
            && d.browser.size() <= 40
            && d.screen is string
            && d.screen.size() <= 30
            && d.visitCount is int
            && d.visitCount >= 1
            && d.visitCount <= 100000
            && d.lastVisit == request.time
            && (!('language' in d) || (d.language is string && d.language.size() <= 20))
            && (!('referrer' in d) || (d.referrer is string && d.referrer.size() <= 250))
            && (!('guestCode' in d) || (d.guestCode is string && d.guestCode.size() <= 30))
            && (!('guestName' in d) || (d.guestName is string && d.guestName.size() <= 160));
      }

      function validVisitorCreate() {
        let d = request.resource.data;
        return validVisitorData()
            && d.firstVisit == request.time;
      }

      function validVisitorUpdate() {
        let d = request.resource.data;
        return validVisitorData()
            && resource.data.visitorId == d.visitorId
            && d.firstVisit == resource.data.firstVisit
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'visitCount', 'lastVisit', 'screen', 'referrer', 'guestCode', 'guestName'
               ]);
      }

      // Chỉ admin mới có quyền xem thông tin chi tiết hoặc liệt kê danh sách thiết bị.
      allow read, list: if isAdmin();

      // Thiết bị gửi thông tin lần đầu (tạo mới).
      allow create: if validVisitorCreate();

      // Thiết bị tự cập nhật số lượt truy cập và thông tin tương tác (mã khách, tên khách...).
      allow update: if validVisitorUpdate();

      // Chỉ admin mới có quyền xoá dữ liệu thiết bị.
      allow delete: if isAdmin();
    }
  }
}
